{
	"name": "zatiaraspos",
	"private": true,
	"version": "2.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/export-durable-objects.mjs",
		"deploy:check": "node scripts/verify-cloudflare-deploy-config.mjs",
		"deploy:realtime": "wrangler deploy --config wrangler.realtime.jsonc",
		"deploy:pages": "wrangler pages deploy .svelte-kit/cloudflare --project-name zatiaraspos --branch main --commit-dirty=true",
		"deploy:all": "pnpm deploy:check && pnpm build && pnpm deploy:realtime && pnpm deploy:pages",
		"d1:backup": "node scripts/d1-backup.mjs",
		"d1:restore": "node scripts/d1-restore.mjs",
		"security:rotate-production": "node scripts/rotate-production-credentials.mjs",
		"test:d1-backup": "node --test scripts/d1-backup.test.mjs",
		"test:uat-live-safety": "node scripts/uat-live-realtime.mjs --self-test",
		"test:operations": "pnpm test:d1-backup && pnpm test:uat-live-safety",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:quality": "tsx src/tests/code-quality-tests.ts",
		"test:quality:all": "tsx src/tests/code-quality-tests.ts all",
		"test:quality:typescript": "tsx src/tests/code-quality-tests.ts typescript",
		"test:quality:linting": "tsx src/tests/code-quality-tests.ts linting",
		"test:quality:structure": "tsx src/tests/code-quality-tests.ts structure",
		"test:quality:dependencies": "tsx src/tests/code-quality-tests.ts dependencies",
		"test:hardening": "tsx src/tests/hardening-regression-tests.ts",
		"test:stores": "tsx src/tests/store-state-tests.ts",
		"test:unit": "pnpm test:hardening && pnpm test:stores && pnpm test:offline && pnpm test:pos-integrity && pnpm test:receipt-output && pnpm test:report-grouping",
		"test:all": "pnpm test:operations && pnpm test:quality && pnpm test:unit",
		"test:release": "pnpm test:all && pnpm build && pnpm test:e2e:pos",
		"test:offline": "tsx src/tests/offline-pos-tests.ts",
		"test:pos-integrity": "tsx src/tests/pos-integrity-tests.ts",
		"test:pos-integrity:local": "node scripts/uat-pos-integrity.mjs",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:pos": "node scripts/run-playwright-local.mjs e2e/pos.spec.ts",
		"test:checkout:local": "node scripts/uat-checkout-financials.mjs",
		"test:receipt-output": "tsx src/tests/receipt-output-tests.ts",
		"test:report-grouping": "tsx src/tests/report-grouping-tests.ts",
		"test:csp:local": "node scripts/uat-csp-pages.mjs",
		"test:csrf:local": "node scripts/uat-csrf-mutations.mjs",
		"test:final:local": "node scripts/uat-final-workflows.mjs",
		"test:security:local": "node scripts/uat-security-rate-limits.mjs",
		"test:load:checkout": "node scripts/loadtest-checkout.mjs",
		"d1:setup:local": "node scripts/setup-local-d1.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260811.1",
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.30.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/vite": "^4.1.11",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.0.0",
		"@types/pako": "^2.0.4",
		"@types/uuid": "^11.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.21",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.10.1",
		"globals": "^16.3.0",
		"postcss": "^8.5.26",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"rollup-plugin-visualizer": "^6.0.3",
		"svelte": "^5.55.8",
		"svelte-check": "^4.2.2",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.20.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.36.0",
		"vite": "^6.4.3",
		"workbox-build": "^7.4.1",
		"wrangler": "^4.120.1"
	},
	"dependencies": {
		"@khmyznikov/pwa-install": "^0.6.3",
		"bcryptjs": "^3.0.2",
		"drizzle-orm": "^0.45.2",
		"idb-keyval": "^6.2.2",
		"js-base64": "^3.7.7",
		"lucide-svelte": "^0.535.0",
		"pako": "^2.1.0",
		"uuid": "^11.1.1",
		"workbox-window": "^7.4.1"
	}
}
